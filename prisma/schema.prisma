// Prisma Schema for Licensed Real Estate Broker Listing & CRM System
// 개업공인중개사용 스마트 매물장 및 고객관리(CRM) 통합 시스템
// SQLite / PostgreSQL 지원

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // PostgreSQL 배포시 "postgresql"로 변경 가능
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. 고객 관리 (CRM)
// ==========================================

model Customer {
  id        String   @id @default(cuid())
  name      String   // 고객명 (예: 홍길동)
  // 통신사: SK, SK알뜰폰, LG, LG알뜰폰, KT, KT알뜰폰 (매도/임대인 선택입력, 매수/임차인은 불필요)
  carrier   String?   
  phone     String   // 전화번호 (예: 010-1234-5678)
  // 고객구분: SELLER(매도), BUYER(매수), LESSOR(임대), LESSEE(임차)
  type      String   
  // 메인 그룹 구분: RECEIVED([물건 접수] 매도인/임대인), SEARCHING([물건 찾음] 매수인/임차인)
  group     String   @default("RECEIVED")
  memo      String?  // 특이사항 및 상담 메모
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:N 관계: 매도/임대인이 접수한 매물 목록
  properties Property[]
  // 1:N 관계: 매수/임차인이 찾는 희망 조건 목록
  demands    CustomerDemand[]

  @@index([phone])
  @@index([group])
  @@index([type])
}

// [물건 찾음] 매수인 / 임차인 희망 조건
model CustomerDemand {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // 희망 매물 종류: APARTMENT(아파트), HOUSE(주택), STORE(상가점포), OFFICE(사무실), FACTORY_WAREHOUSE(공장창고), LAND(토지), ETC(기타)
  targetPropertyType    String    
  // 거래유형: 매매, 전세, 월세
  targetTransactionType String    
  targetRegion          String?   // 희망 지역 (예: 강남구 역삼동, 역세권 도보 5분)
  
  // 예산 조건 (단위: 만원)
  minBudget             Float?    // 최소 매매가/희망예산
  maxBudget             Float?    // 최대 매매가/희망예산
  minDeposit            Float?    // 최소 보증금
  maxDeposit            Float?    // 최대 보증금
  minMonthlyRent        Float?    // 최소 월세
  maxMonthlyRent        Float?    // 최대 월세
  
  preferredArea         Float?    // 희망 전용/실면적 (㎡)
  moveInDate            DateTime? // 입주 희망일
  requirements          String?   // 기타 요청사항/선호옵션
  status                String    @default("ACTIVE") // ACTIVE(상담/탐색중), MATCHED(매칭완료), HOLD(보류)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@index([targetPropertyType])
}

// ==========================================
// 2. 매물 공통 스키마
// ==========================================

model Property {
  id                  String    @id @default(cuid())
  // 매물번호 (중개사 수동 직접 입력 고유번호)
  propertyNumber      String    @unique
  receiptDate         DateTime  @default(now()) // 접수일자
  // 매물종류: APARTMENT, HOUSE, STORE, OFFICE, FACTORY_WAREHOUSE, LAND, ETC
  propertyType        String    
  // 거래상태: AVAILABLE(접수/진행중), CONTRACTED(계약완료), HOLD(보류), CANCELLED(취소)
  status              String    @default("AVAILABLE")
  
  // 거래유형: 매매, 전세, 월세
  transactionType     String    
  
  // 소재지 주소
  address             String    // 도로명/지번 주소
  detailAddress       String?   // 동/호수 또는 층수 (선택)
  
  // 지도 위치 좌표 (위도/경도)
  latitude            Float?    // 위도 (예: 37.4998)
  longitude           Float?    // 경도 (예: 127.0384)
  
  // 방향 및 기준
  direction           String?   // 남향, 동향, 남동향, 북향 등
  directionCriteria   String?   // 거실기준, 안방기준, 주출입구기준 등
  
  // 일정 및 가격 (단위: 만원)
  availableDate       DateTime? // 입주가능일 (즉시입주 가능 여부 포함)
  price               Float?    // 매매가 (만원)
  deposit             Float?    // 보증금 (만원)
  monthlyRent         Float?    // 월세 (만원)
  
  consultationNotes   String?   // 상담내용(메모)

  // 공공데이터포털 API 연동 캐시 필드 (건축물대장/토지대장 연동)
  landArea            Float?    // 대지면적 (㎡)
  totalFloorArea      Float?    // 연면적 (㎡)
  approvalDate        DateTime? // 사용승인일
  buildingRegisterUse String?   // 건축물대장상 주용도

  // 접수한 고객 (매도인/임대인 연결)
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // 7가지 매물 유형별 1:1 세부 스펙 관계
  apartmentDetail        ApartmentDetail?
  houseDetail            HouseDetail?
  storeDetail            StoreDetail?
  officeDetail           OfficeDetail?
  factoryWarehouseDetail FactoryWarehouseDetail?
  landDetail             LandDetail?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([propertyNumber])
  @@index([propertyType])
  @@index([transactionType])
  @@index([status])
}

// ==========================================
// 3. 7가지 매물 종류별 세부 스키마
// ==========================================

// 1) 아파트 세부 정보
model ApartmentDetail {
  id               String   @id @default(cuid())
  propertyId       String   @unique
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 단지 정보
  complexName      String   // 단지명 (예: 래미안 대치팰리스)
  buildingNo       String?  // 동 (예: 101동)
  unitNo           String?  // 호수 (예: 1204호)

  // 면적 및 스펙
  supplyArea       Float?   // 공급면적 (㎡)
  pyeongType       String?  // 평타입 (예: 84A, 34평형)
  exclusiveArea    Float?   // 전용면적 (㎡)
  roomCount        Int?     // 방수
  bathroomCount    Int?     // 욕실수
  approvalDate     DateTime? // 사용승인일
  elevatorCount    Int?     // 엘리베이터 수

  // 비용 및 시설
  maintenanceFee   Float?   // 관리비 (만원)
  heatingType      String?  // 난방방식 (도시가스/개별난방/지역난방/LPG 등)

  // 옵션 선택
  systemAircon     Boolean  @default(false) // 시스템에어컨
  roomLivingOption String?  // 방/거실 옵션 (확장형/기본형)
  heatExchanger    Boolean  @default(false) // 전열교환기
  induction        Boolean  @default(false) // 인덕션
  otherOptions     String?  // 기타옵션
}

// 2) 주택 세부 정보 (단독/다가구/다세대/연립/빌라)
model HouseDetail {
  id                    String   @id @default(cuid())
  propertyId            String   @unique
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 건축 개요
  totalFloors           Int?     // 총층수
  currentFloor          String?  // 해당층수 (지상1층, 지하1층 등)
  landArea              Float?   // 대지면적 (㎡)
  totalFloorArea        Float?   // 연면적 (㎡)
  buildingArea          Float?   // 건축물대장상 면적 (㎡)
  buildingUse           String?  // 건축물대장상 용도 (단독주택, 다가구주택 등)
  approvalDate          DateTime? // 사용승인일

  // 내부 스펙
  roomCount             Int?     // 방수
  bathroomCount         Int?     // 욕실수
  currentLeaseStatus    String?  // 현재 임대현황 (보증금/월세 구성 등)
  parkingCount          Int?     // 가능주차대수

  // 비용 및 시설
  maintenanceFeeCommon  Float?   // 관리비 (공용)
  maintenanceFeeWater   Float?   // 관리비 (수도)
  maintenanceFeeElectricity Float? // 관리비 (전기)
  maintenanceFeeGas     Float?   // 관리비 (가스)
  heatingType           String?  // 난방방식
  options               String?  // 옵션항목
}

// 3) 상가점포 세부 정보 & 🚨 상담 체크리스트
model StoreDetail {
  id                         String   @id @default(cuid())
  propertyId                 String   @unique
  property                   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 점포 기본
  storeName                  String?  // 상호명
  businessType               String?  // 업종 (일반음식점, 카페, 미용실 등)
  totalFloors                Int?     // 총층수
  currentFloor               String?  // 해당층수 (지상 1층, 지하 1층 등)

  // 면적 및 스펙
  landArea                   Float?   // 대지면적 (㎡)
  buildingArea               Float?   // 건축물대장상 면적 (㎡)
  buildingUse                String?  // 건축물대장상 용도 (제1종/제2종 근린생활시설 등)
  actualArea                 Float?   // 실평수 (㎡)
  roomCount                  Int?     // 방수 / 구획룸 수
  bathroomCount              Int?     // 욕실/화장실 수
  approvalDate               DateTime? // 사용승인일
  parkingCount               Int?     // 가능주차대수

  // 금액 조건
  monthlyRentVat             Boolean  @default(false) // 월세 부가세 별도 여부
  premium                    Float?   // 권리금 (만원)
  maintenanceFee             Float?   // 관리비 (만원)
  maintenanceFeeVat          Boolean  @default(false) // 관리비 부가세 별도 여부

  // 🚨 상담 체크리스트 (UI 고정 노출 항목)
  adminActionChecked         String?  // 행정처분체크 (유무/내역)
  violationBuilding          String?  // 위반건축물 (유무/내역)
  operationPeriod            String?  // 영업기간 (운영 개월/년수)
  contractPeriod             String?  // 계약기간 (잔여기간 등)
  parkingRequirement         String?  // 주차장 요건
  businessRegistrationStatus String?  // 사업자등록여부 및 명의자
  rentIncreaseStatus         String?  // 임대료 인상여부 및 조건
  advertisementStatus        String?  // 점포광고여부 (온라인/포털/비공개)
  tableCountHall             Int?     // 테이블수 (홀)
  tableCountRoom             Int?     // 테이블수 (룸)
  employeeCount              Int?     // 종업원수
  dailyRevenue               Float?   // 일매출 (만원)
  equipmentStatus            String?  // 비품체크 (인수불가/렌탈 품목 목록)
  liquorLoan                 String?  // 주류대출여부 및 승계조건
  fireInspectionCert         String?  // 소방필증 (완비증명서 구비 여부)
}

// 4) 사무실 세부 정보 & 🚨 상담 체크리스트
model OfficeDetail {
  id                   String   @id @default(cuid())
  propertyId           String   @unique
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 사무실 기본
  officeName           String?  // 상호명/입주사명
  totalFloors          Int?     // 총층수
  currentFloor         String?  // 해당층수

  // 면적 및 스펙
  landArea             Float?   // 대지면적 (㎡)
  buildingArea         Float?   // 건축물대장상 면적 (㎡)
  buildingUse          String?  // 건축물대장상 용도 (업무시설 등)
  actualArea           Float?   // 실평수 (㎡)
  roomCount            Int?     // 룸/회의실 수
  bathroomCount        Int?     // 화장실 수 (전용/공용)
  approvalDate         DateTime? // 사용승인일
  parkingCount         Int?     // 배정 주차대수

  // 금액 조건
  monthlyRentVat       Boolean  @default(false) // 월세 부가세 별도 여부
  maintenanceFee       Float?   // 관리비 (만원)
  maintenanceFeeVat    Boolean  @default(false) // 관리비 부가세 별도 여부

  // 🚨 상담 체크리스트 (UI 고정 노출 항목)
  violationBuilding    String?  // 위반건축물 여부
  parkingAndFee        String?  // 주차대수 및 추가 주차 요금 규정
  rentIncreaseStatus   String?  // 임대료 인상여부/재계약 조건
  advertisementStatus  String?  // 점포/사무실 광고 노출 여부
  prosAndCons          String?  // 매물 장단점 (채광, 조망, 역세권 등)
  hvacSystem           String?  // 냉난방 시스템 (개별/중앙/FCU/천장형)
  elevator             String?  // 엘리베이터 (승객용/화물용 대수)
  security             String?  // 보안 시스템 (지문/캡스/경비실 상주)
  restorationScope     String?  // 원상복구 범위 명확화 (칸막이, 바닥, 천장)
  electricityExpansion String?  // 전기 증설 가능 여부 및 용량
  specialTerms         String?  // 특약사항
  totalOfficeCount     Int?     // 건물내 총사무실수
}

// 5) 공장/창고 세부 정보 & 🚨 상담 체크리스트
model FactoryWarehouseDetail {
  id                     String   @id @default(cuid())
  propertyId             String   @unique
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 공장 기본
  companyName            String?  // 상호명
  businessType           String?  // 업종 (제조업, 물류창고, 금속가공 등)
  totalFloors            Int?     // 총층
  currentFloor           String?  // 해당층
  structure              String?  // 건축구조 (일반철골조, 샌드위치패널, 철근콘크리트)
  approvalDate           DateTime? // 사용승인일

  // 면적 및 토지
  landArea               Float?   // 대지면적 (㎡)
  totalFloorArea         Float?   // 연면적 (㎡)
  buildingArea           Float?   // 건축물대장상 면적 (㎡)
  buildingUse            String?  // 건축물대장상 용도 (공장, 창고시설)
  zoningArea             String?  // 용도지역/지구 (일반공업지역, 계획관리지역 등)
  landCategory           String?  // 지목 (장, 대, 잡종지 등)
  roadAccessWidth        String?  // 진입도로 폭 (예: 6m, 8m, 12m 대형트레일러 진입가)

  // 산업 스펙
  ceilingHeight          Float?   // 층고 (m단위 - 처마고 / 최고고)
  hoistCapacity          String?  // 호이스트 (톤수 - 예: 2.8톤, 5톤, 없음)
  incomingElectricity    String?  // 인입전력 (예: 50kW, 150kW)
  operatingElectricity   String?  // 현재 사용전력 (kW)
  parkingCount           Int?     // 가능주차대수 (대형차/화물차 포함)

  // 금액 조건
  rentPerPyeong          Float?   // 평당임대료 (산출용)

  // 🚨 상담 체크리스트 (UI 고정 노출 항목)
  wastewater             String?  // 폐수 배출 여부 및 위탁/정화조 처리
  airPollution           String?  // 대기 오염 물질 배출 여부/집진기 구비
  noiseLevel             String?  // 소음/진동 발생 여부 및 민원 이력
  allowedBusinessTypes   String?  // 지자체 조례상 입주가능업종 코드
  sewageDirectConnection String?  // 하수종말처리장 직관 연결 여부
}

// 6) 토지 세부 정보 & 🚨 상담 체크리스트
model LandDetail {
  id                     String   @id @default(cuid())
  propertyId             String   @unique
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 토지 개요
  companyName            String?  // 상호명 (있는 경우)
  businessType           String?  // 현재 이용상황/업종
  landArea               Float?   // 대지면적 (㎡)
  rentPerPyeong          Float?   // 평당임대료 또는 평당매매가 (만원)

  // 토지 스펙
  zoningArea             String?  // 용도지역 (자연녹지지역, 계획관리지역, 제1종일반주거지역 등)
  landCategory           String?  // 지목 (전, 답, 대, 임야, 잡종지 등)
  roadAccess             String?  // 도로 접도 여부 (맹지, 4m접, 2차선접 등)

  // 🚨 상담 체크리스트 (UI 고정 노출 항목)
  ordinancePermitted     String?  // 매수자가 원하는 건축물이 해당 용도지역 조례상 허용여부
  roadAccessConfirmed    String?  // 건축법상 진입도로(폭 4m 이상 등) 확보 여부
  surfaceRights          String?  // 지상권 설정 여부 (법정지상권 포함)
  easementRights         String?  // 지역권 설정 여부
  farmlandsCert          String?  // 농지취득자격증명(농취증) 발급 가능 여부
  landPermitZone         String?  // 토지거래허가구역 해당 여부
  greenBeltZone          String?  // 개발제한구역(그린벨트) 해당 여부
  unauthorizedStructures String?  // 무허가 건축물/비닐하우스/수목/농작물 소유자 파악
  infrastructure         String?  // 기반 시설 인입 여부 (전기, 가스, 통신)
  waterSewageConnection  String?  // 상수도 / 하수관로 연결 가능 여부
}
