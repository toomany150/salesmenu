# 데이터베이스 접속 URL (기본 SQLite 파일 기반 로컬 DB, PostgreSQL 사용시 postgresql://user:password@localhost:5432/broker_crm 형식으로 지정)
DATABASE_URL="file:./dev.db"

# 카카오 공유 API JavaScript 키 (Kakao Developers 콘솔에서 발급)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY="demo_kakao_key_replace_with_yours"

# 공공데이터포털(data.go.kr) 건축물대장 / 토지대장 조회 서비스 일반 인증키(인코딩/디코딩)
DATA_GO_KR_API_KEY="demo_public_data_portal_api_key_here"
